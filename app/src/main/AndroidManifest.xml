<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network (clone / push / GitHub API / release checks) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage for Documents/QuickGitNEXT on API ≤ 29 (see MainActivity + RepoManager) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Progress notifications for clone / push / pull (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Touchscreen is not required so the app can run on Chromebooks / desktop-class
      devices that rely on keyboard + trackpad / mouse.
    -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <application
        android:name=".QuickGitApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false"
        android:resizeableActivity="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:importantForAutofill="yes"
            android:enableOnBackInvokedCallback="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Tablets / ChromeOS / freeform: stretch to the available window, any orientation -->
            <layout
                android:defaultWidth="1100dp"
                android:defaultHeight="800dp"
                android:minWidth="320dp"
                android:minHeight="400dp"
                android:gravity="fill" />
            <!-- ChromeOS: open maximized / full freeform when possible -->
            <meta-data
                android:name="WindowManagerPreference:FreeformWindowSize"
                android:value="maximize" />
            <meta-data
                android:name="WindowManagerPreference:FreeformWindowOrientation"
                android:value="landscape" />
        </activity>

        <!-- Wear OS Data Layer: answers /quickgitnext/request_sync from the companion watch app -->
        <service
            android:name=".wear.WearMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/quickgitnext" />
            </intent-filter>
        </service>
    </application>
</manifest>
